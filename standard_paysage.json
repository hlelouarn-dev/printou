"""
Dialogue de mise à jour Printou v0.6 :
- Onglet "GitHub" : vérif auto + bouton télécharger
- Onglet "Fichier ZIP" : sélection manuelle d'un zip local
- Téléchargement dans un thread séparé pour ne pas geler l'UI
"""

from __future__ import annotations

import tempfile
from pathlib import Path

from PySide6.QtCore import QObject, Qt, QThread, Signal
from PySide6.QtWidgets import (
    QDialog,
    QDialogButtonBox,
    QFileDialog,
    QFrame,
    QHBoxLayout,
    QLabel,
    QMessageBox,
    QProgressBar,
    QPushButton,
    QTabWidget,
    QTextBrowser,
    QVBoxLayout,
    QWidget,
)

from printou import __github_repo__, __version__
from printou.core import (
    GitHubError, GitHubRelease, UpdateError, UpdateInfo,
    download_release_zip, fetch_latest_release, humanize_size,
    inspect_zip, install_update,
)
from printou.ui.theme import Colors


# ============================================================
# Workers en thread
# ============================================================

class FetchReleaseWorker(QObject):
    """Vérifie la dernière release sur GitHub (sans télécharger)."""
    finished = Signal(object)  # GitHubRelease ou None
    failed = Signal(str)

    def run(self):
        try:
            from printou.core.updater import is_frozen
            release = fetch_latest_release(__github_repo__, timeout=10,
                                           prefer_frozen=is_frozen())
            self.finished.emit(release)
        except GitHubError as e:
            self.failed.emit(str(e))
        except Exception as e:
            self.failed.emit(f"Erreur inattendue : {e}")


class DownloadWorker(QObject):
    """Télécharge le ZIP d'une release."""
    progress = Signal(int, int)  # bytes_lus, total
    finished = Signal(str)        # chemin du fichier téléchargé
    failed = Signal(str)

    def __init__(self, release: GitHubRelease):
        super().__init__()
        self.release = release

    def run(self):
        try:
            target_dir = Path(tempfile.gettempdir()) / "printou_download"
            zip_path = download_release_zip(
                self.release, target_dir,
                progress_callback=lambda dl, tot: self.progress.emit(dl, tot),
                timeout=60,
            )
            self.finished.emit(str(zip_path))
        except GitHubError as e:
            self.failed.emit(str(e))
        except Exception as e:
            self.failed.emit(f"Erreur inattendue : {e}")


# ============================================================
# Dialog principal
# ============================================================

class UpdateDialog(QDialog):
    def __init__(self, parent=None, auto_check_github: bool = True):
        super().__init__(parent)
        self.setWindowTitle("Mettre à jour Printou")
        self.resize(680, 540)
        self.setModal(True)

        self._update_info: UpdateInfo | None = None
        self._github_release: GitHubRelease | None = None
        self._fetch_thread: QThread | None = None
        self._download_thread: QThread | None = None

        self._init_ui()

        if auto_check_github:
            self._start_github_check()

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(12)

        # Titre
        title = QLabel("<h2>🔄 Mise à jour de Printou</h2>")
        title.setTextFormat(Qt.RichText)
        layout.addWidget(title)

        self.current_label = QLabel(
            f"<p>Version actuellement installée : <b>{__version__}</b></p>"
        )
        self.current_label.setTextFormat(Qt.RichText)
        layout.addWidget(self.current_label)

        # Onglets : GitHub + Fichier ZIP
        self.tabs = QTabWidget()
        self.tabs.addTab(self._build_github_tab(), "🌐  En ligne (GitHub)")
        self.tabs.addTab(self._build_local_tab(), "📁  Fichier ZIP local")
        layout.addWidget(self.tabs, stretch=1)

        # Boutons en bas
        self.button_box = QDialogButtonBox()
        self.install_btn = self.button_box.addButton(
            "✓ Installer", QDialogButtonBox.AcceptRole,
        )
        self.install_btn.setEnabled(False)
        self.install_btn.setStyleSheet(f"""
            QPushButton {{
                background: {Colors.ACCENT};
                color: {Colors.BG};
                font-weight: bold;
                padding: 10px 18px;
                border-radius: 6px;
            }}
            QPushButton:hover {{ background: {Colors.ACCENT_HOVER}; }}
            QPushButton:disabled {{ background: {Colors.BORDER}; color: {Colors.TEXT_MUTED}; }}
        """)
        self.cancel_btn = self.button_box.addButton(
            "Fermer", QDialogButtonBox.RejectRole,
        )
        self.button_box.accepted.connect(self._on_install_clicked)
        self.button_box.rejected.connect(self.reject)
        layout.addWidget(self.button_box)

    # ─── Onglet GitHub ───

    def _build_github_tab(self) -> QWidget:
        w = QWidget()
        layout = QVBoxLayout(w)
        layout.setContentsMargins(8, 12, 8, 8)

        intro = QLabel(
            f"<p>Vérifie automatiquement les nouvelles versions publiées sur GitHub :<br>"
            f"<code>{__github_repo__}</code></p>"
        )
        intro.setTextFormat(Qt.RichText)
        layout.addWidget(intro)

        # Statut + bouton vérifier
        status_row = QHBoxLayout()
        self.gh_status = QLabel("Cliquez sur 'Vérifier' pour rechercher une mise à jour…")
        self.gh_status.setTextFormat(Qt.RichText)
        self.gh_status.setWordWrap(True)
        status_row.addWidget(self.gh_status, stretch=1)

        self.gh_check_btn = QPushButton("🔍 Vérifier maintenant")
        self.gh_check_btn.clicked.connect(self._start_github_check)
        status_row.addWidget(self.gh_check_btn)
        layout.addLayout(status_row)

        # Détails de la release (caché tant qu'on n'a pas de release)
        self.gh_release_box = QFrame()
        self.gh_release_box.setFrameShape(QFrame.StyledPanel)
        self.gh_release_box.setStyleSheet(
            f"QFrame {{ background: {Colors.SURFACE}; border-radius: 6px; padding: 10px; }}"
        )
        rb_layout = QVBoxLayout(self.gh_release_box)
        rb_layout.setContentsMargins(12, 12, 12, 12)

        self.gh_release_title = QLabel("")
        self.gh_release_title.setTextFormat(Qt.RichText)
        self.gh_release_title.setWordWrap(True)
        rb_layout.addWidget(self.gh_release_title)

        self.gh_release_meta = QLabel("")
        self.gh_release_meta.setTextFormat(Qt.RichText)
        self.gh_release_meta.setStyleSheet(f"color: {Colors.TEXT_DIM};")
        rb_layout.addWidget(self.gh_release_meta)

        self.gh_release_body = QTextBrowser()
        self.gh_release_body.setMaximumHeight(180)
        self.gh_release_body.setStyleSheet(f"background: {Colors.BG};")
        rb_layout.addWidget(self.gh_release_body)

        # Barre de progression de téléchargement (cachée par défaut)
        self.gh_progress = QProgressBar()
        self.gh_progress.setVisible(False)
        rb_layout.addWidget(self.gh_progress)

        self.gh_release_box.setVisible(False)
        layout.addWidget(self.gh_release_box)

        layout.addStretch()
        return w

    def _start_github_check(self):
        """Lance la vérification GitHub en thread."""
        self.gh_check_btn.setEnabled(False)
        self.gh_status.setText("⏳ <i>Connexion à GitHub en cours…</i>")
        self.gh_release_box.setVisible(False)

        self._fetch_thread = QThread()
        worker = FetchReleaseWorker()
        worker.moveToThread(self._fetch_thread)
        self._fetch_thread.started.connect(worker.run)
        worker.finished.connect(self._on_github_check_done)
        worker.failed.connect(self._on_github_check_failed)
        worker.finished.connect(self._fetch_thread.quit)
        worker.failed.connect(self._fetch_thread.quit)
        # Garder une référence sinon Qt détruit le worker
        self._fetch_worker = worker
        self._fetch_thread.start()

    def _on_github_check_done(self, release: GitHubRelease):
        self.gh_check_btn.setEnabled(True)
        self._github_release = release

        if release.is_same_as(__version__):
            self.gh_status.setText(
                f"✅ Tu as déjà la dernière version (<b>{release.version}</b>)."
            )
            self.gh_release_box.setVisible(False)
            self.install_btn.setEnabled(False)
            return

        if not release.is_newer_than(__version__):
            self.gh_status.setText(
                f"<span style='color:#e0a000'>⚠ La dernière release publiée "
                f"(<b>{release.version}</b>) est plus ancienne que ta version "
                f"installée (<b>{__version__}</b>).</span>"
            )
        else:
            self.gh_status.setText(
                f"🎉 <b>Mise à jour disponible :</b> "
                f"<span style='color:{Colors.ACCENT}'><b>{__version__} → {release.version}</b></span>"
            )

        # Affichage des détails
        self.gh_release_title.setText(f"<h3>{release.name}</h3>")
        meta = f"Tag : <code>{release.tag_name}</code>"
        if release.published_at:
            # Format ISO simplifié (YYYY-MM-DD)
            meta += f"  ·  Publié le {release.published_at[:10]}"
        if release.zip_size:
            meta += f"  ·  ZIP : {humanize_size(release.zip_size)}"
        self.gh_release_meta.setText(meta)

        # Body en markdown brut (suffisant)
        self.gh_release_body.setMarkdown(release.body or "_(pas de description)_")
        self.gh_release_box.setVisible(True)

        # Activer le bouton install seulement s'il y a un zip et que c'est différent
        if release.zip_url and not release.is_same_as(__version__):
            self.install_btn.setEnabled(True)
            self.tabs.setCurrentIndex(0)  # focus onglet GitHub
        else:
            self.install_btn.setEnabled(False)

    def _on_github_check_failed(self, msg: str):
        self.gh_check_btn.setEnabled(True)
        self.gh_status.setText(f"<span style='color:#d04040'>⚠ {msg}</span>")
        self.gh_release_box.setVisible(False)
        self.install_btn.setEnabled(False)

    # ─── Onglet ZIP local ───

    def _build_local_tab(self) -> QWidget:
        w = QWidget()
        layout = QVBoxLayout(w)
        layout.setContentsMargins(8, 12, 8, 8)

        intro = QLabel(
            "<p>Sélectionne un fichier ZIP de mise à jour Printou (par exemple "
            "<code>printou_v0.6.zip</code>) que tu as téléchargé manuellement.</p>"
        )
        intro.setTextFormat(Qt.RichText)
        intro.setWordWrap(True)
        layout.addWidget(intro)

        # Bouton choisir
        btn_row = QHBoxLayout()
        self.choose_btn = QPushButton("📁  Choisir un fichier ZIP…")
        self.choose_btn.clicked.connect(self._choose_local_zip)
        btn_row.addWidget(self.choose_btn)
        self.local_zip_label = QLabel("<i>Aucun fichier sélectionné</i>")
        self.local_zip_label.setTextFormat(Qt.RichText)
        btn_row.addWidget(self.local_zip_label, stretch=1)
        layout.addLayout(btn_row)

        # Info sur le ZIP
        self.local_info = QLabel("")
        self.local_info.setTextFormat(Qt.RichText)
        self.local_info.setWordWrap(True)
        self.local_info.setVisible(False)
        layout.addWidget(self.local_info)

        layout.addStretch()
        return w

    def _choose_local_zip(self):
        zip_path_str, _ = QFileDialog.getOpenFileName(
            self,
            "Sélectionne le fichier ZIP de mise à jour",
            str(Path.home()),
            "Archives ZIP (*.zip);;Tous les fichiers (*.*)",
        )
        if not zip_path_str:
            return
        self._inspect_local_zip(Path(zip_path_str))

    def _inspect_local_zip(self, zip_path: Path):
        self.local_zip_label.setText(
            f"<b>{zip_path.name}</b><br><small>{zip_path.parent}</small>"
        )
        try:
            self._update_info = inspect_zip(zip_path, current_version=__version__)
        except UpdateError as e:
            QMessageBox.warning(self, "ZIP invalide", str(e))
            self._update_info = None
            self.local_info.setVisible(False)
            self.install_btn.setEnabled(False)
            return

        info = self._update_info
        if info.is_same:
            self.local_info.setText(
                f"<p style='color:{Colors.TEXT_DIM}'>Le ZIP contient la même version "
                f"(<b>{info.target_version}</b>). Aucune installation nécessaire.</p>"
            )
            self.install_btn.setEnabled(False)
        elif not info.is_newer:
            self.local_info.setText(
                f"<p style='color:#e0a000'>⚠ Version <b>plus ancienne</b> "
                f"({info.target_version}) que celle installée ({info.current_version}).<br>"
                "Tu peux installer un downgrade si tu veux.</p>"
            )
            self.install_btn.setEnabled(True)
            self.tabs.setCurrentIndex(1)
        else:
            self.local_info.setText(
                f"<p>Mise à jour : "
                f"<b>{info.current_version}</b> → <b style='color:{Colors.ACCENT}'>{info.target_version}</b></p>"
            )
            self.install_btn.setEnabled(True)
            self.tabs.setCurrentIndex(1)

        self.local_info.setVisible(True)

    # ─── Installation (commune aux 2 onglets) ───

    def _on_install_clicked(self):
        # Quel onglet est actif ?
        if self.tabs.currentIndex() == 0:
            self._install_from_github()
        else:
            self._install_from_local_zip()

    def _install_from_github(self):
        if self._github_release is None or self._github_release.zip_url is None:
            return

        ret = QMessageBox.question(
            self, "Confirmer la mise à jour",
            f"Télécharger et installer Printou {self._github_release.version} ?\n\n"
            f"Le ZIP fait {humanize_size(self._github_release.zip_size)}.\n"
            "Printou se fermera automatiquement après le téléchargement.",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes,
        )
        if ret != QMessageBox.Yes:
            return

        # Bloquer les actions, lancer le téléchargement en thread
        self.install_btn.setEnabled(False)
        self.cancel_btn.setEnabled(False)
        self.gh_check_btn.setEnabled(False)
        self.choose_btn.setEnabled(False)
        self.gh_progress.setVisible(True)
        self.gh_progress.setRange(0, 100)
        self.gh_progress.setValue(0)
        self.gh_status.setText("📥 <b>Téléchargement en cours…</b>")

        self._download_thread = QThread()
        worker = DownloadWorker(self._github_release)
        worker.moveToThread(self._download_thread)
        self._download_thread.started.connect(worker.run)
        worker.progress.connect(self._on_download_progress)
        worker.finished.connect(self._on_download_finished)
        worker.failed.connect(self._on_download_failed)
        worker.finished.connect(self._download_thread.quit)
        worker.failed.connect(self._download_thread.quit)
        self._download_worker = worker
        self._download_thread.start()

    def _on_download_progress(self, downloaded: int, total: int):
        if total > 0:
            pct = int(downloaded / total * 100)
            self.gh_progress.setValue(pct)
            self.gh_status.setText(
                f"📥 <b>Téléchargement…</b> "
                f"{humanize_size(downloaded)} / {humanize_size(total)}  ({pct}%)"
            )
        else:
            self.gh_status.setText(
                f"📥 <b>Téléchargement…</b> {humanize_size(downloaded)}"
            )

    def _on_download_finished(self, zip_path_str: str):
        self.gh_status.setText("✅ <b>Téléchargement terminé. Installation…</b>")
        self.gh_progress.setValue(100)
        self._inspect_local_zip(Path(zip_path_str))
        if self._update_info is not None:
            self._do_install(self._update_info)

    def _on_download_failed(self, msg: str):
        self.gh_progress.setVisible(False)
        self.install_btn.setEnabled(True)
        self.cancel_btn.setEnabled(True)
        self.gh_check_btn.setEnabled(True)
        self.choose_btn.setEnabled(True)
        self.gh_status.setText(
            f"<span style='color:#d04040'>⚠ Téléchargement échoué : {msg}</span>"
        )

    def _install_from_local_zip(self):
        if self._update_info is None:
            return

        ret = QMessageBox.question(
            self, "Confirmer la mise à jour",
            f"Installer Printou {self._update_info.target_version} ?\n\n"
            "Printou va se fermer pour faire la mise à jour, puis se relancer.",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes,
        )
        if ret != QMessageBox.Yes:
            return
        self._do_install(self._update_info)

    def _do_install(self, info: UpdateInfo):
        try:
            install_update(info)
        except Exception as e:
            QMessageBox.critical(
                self, "Erreur",
                f"Échec du lancement de la mise à jour :\n{e}",
            )
            return
        self.accept()
        if self.parent() is not None:
            self.parent().close()

    def closeEvent(self, event):
        # Si un téléchargement est en cours, demander confirmation
        if self._download_thread is not None and self._download_thread.isRunning():
            ret = QMessageBox.question(
                self, "Téléchargement en cours",
                "Un téléchargement est en cours. Vraiment annuler ?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
            )
            if ret != QMessageBox.Yes:
                event.ignore()
                return
        super().closeEvent(event)
